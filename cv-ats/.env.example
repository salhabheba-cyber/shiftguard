# Required: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Password to log in to the app (leave empty to disable login — local use only)
APP_PASSWORD=choose-a-strong-password
# Random string used to sign login cookies
SECRET_KEY=replace-with-a-long-random-string
# Where the database and uploaded CVs are stored (on Railway: mount a volume at /data)
DATA_DIR=/data
# Optional
AI_MODEL=claude-opus-5
AI_EFFORT=high
MAX_WORKERS=3
MAX_UPLOAD_MB=100
# Optional: lets the server read old .doc files (Railway build variable)
RAILPACK_DEPLOY_APT_PACKAGES=antiword
